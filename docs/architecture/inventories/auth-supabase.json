{
  "schemaVersion": 1,
  "supabaseAdmin": "apps/api/src/infrastructure/supabase/admin.ts",
  "authGuard": "apps/api/src/core/guards/auth.guard.ts",
  "tokenResolution": "supabaseAdmin.auth.getUser(token) then prisma.user lookup",
  "cookies": [
    "manut_access_token",
    "manut_refresh_token"
  ],
  "nativeClientHeader": "x-manut-client: native \u2192 include session tokens in JSON for SecureStore",
  "env": {
    "legacySupabase": [
      "SUPABASE_URL",
      "NEXT_PUBLIC_SUPABASE_URL",
      "SUPABASE_SERVICE_ROLE_KEY"
    ],
    "targetAuthHints": [
      "AUTH_JWKS_URL",
      "AUTH_ISSUER",
      "AUTH_AUDIENCE"
    ]
  },
  "httpRoutes": [
    {
      "method": "POST",
      "path": "/api/auth/login"
    },
    {
      "method": "POST",
      "path": "/api/auth/forgot-password"
    },
    {
      "method": "POST",
      "path": "/api/auth/magic-link"
    },
    {
      "method": "POST",
      "path": "/api/auth/recover-password"
    },
    {
      "method": "POST",
      "path": "/api/auth/exchange-session"
    },
    {
      "method": "POST",
      "path": "/api/auth/logout"
    },
    {
      "method": "POST",
      "path": "/api/auth/refresh"
    },
    {
      "method": "GET",
      "path": "/api/auth/me"
    },
    {
      "method": "GET",
      "path": "/api/auth/me/profile"
    },
    {
      "method": "PATCH",
      "path": "/api/auth/me/profile"
    },
    {
      "method": "POST",
      "path": "/api/auth/change-password"
    }
  ],
  "supabaseAuthAdminCalls": {
    "auth.service": [
      "signInWithPassword",
      "admin.updateUserById",
      "resetPasswordForEmail",
      "signInWithOtp",
      "getUser",
      "refreshSession",
      "getUser",
      "admin.createUser",
      "admin.deleteUser",
      "signInWithPassword",
      "admin.updateUserById",
      "admin.updateUserById"
    ],
    "users.service": [
      "admin.createUser",
      "admin.deleteUser",
      "admin.deleteUser",
      "admin.updateUserById",
      "admin.createUser",
      "admin.listUsers",
      "admin.updateUserById",
      "admin.createUser"
    ]
  },
  "directRuntimeTouchFiles": [
    "apps/api/src/infrastructure/supabase/admin.ts",
    "apps/api/src/core/guards/auth.guard.ts",
    "apps/api/src/modules/auth/auth.service.ts",
    "apps/api/src/modules/auth/auth.controller.ts",
    "apps/api/src/modules/users/users.service.ts",
    "apps/api/src/modules/users/users.controller.ts",
    "apps/api/src/infrastructure/storage/supabase-storage.ts"
  ],
  "flows": [
    {
      "id": "password-login",
      "route": "POST /api/auth/login",
      "supabase": "signInWithPassword",
      "emailSourceVerified": "n/a"
    },
    {
      "id": "forgot-password",
      "route": "POST /api/auth/forgot-password",
      "supabase": "resetPasswordForEmail",
      "emailOrigin": "Supabase Auth mailer (outside EMAIL_SERVICE adapter)",
      "disposition": "retire-for-passwordless"
    },
    {
      "id": "magic-link",
      "route": "POST /api/auth/magic-link",
      "supabase": "signInWithOtp",
      "emailOrigin": "Supabase Auth mailer",
      "disposition": "migrate-to-identity-outbox"
    },
    {
      "id": "recover-password",
      "route": "POST /api/auth/recover-password",
      "supabase": "admin.updateUserById",
      "disposition": "retire-with-password"
    },
    {
      "id": "change-password",
      "route": "POST /api/auth/change-password",
      "auth": "authenticated",
      "disposition": "retire-with-password"
    },
    {
      "id": "refresh",
      "route": "POST /api/auth/refresh",
      "supabase": "refreshSession"
    },
    {
      "id": "logout",
      "route": "POST /api/auth/logout"
    },
    {
      "id": "me",
      "route": "GET /api/auth/me",
      "auth": "authenticated"
    },
    {
      "id": "exchange-session",
      "route": "POST /api/auth/exchange-session"
    },
    {
      "id": "update-profile",
      "route": "PATCH /api/auth/me"
    },
    {
      "id": "admin-create-user",
      "via": "users.service",
      "supabase": "admin.createUser"
    },
    {
      "id": "admin-delete-user",
      "via": "users.service",
      "supabase": "admin.deleteUser"
    },
    {
      "id": "admin-update-user",
      "via": "users.service",
      "supabase": "admin.updateUserById"
    }
  ]
}