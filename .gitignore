# Playwright authenticated storage state. Contains live session cookies and
# tokens for the E2E account — never commit it, never attach it to CI
# artifacts. Regenerated by e2e/auth.setup.ts on every run.
playwright/.auth/
*.storageState.json

# Agent instruction files generated by `next dev`, not authored here — they
# carry a <!-- BEGIN:nextjs-agent-rules --> marker and are rewritten on every
# dev run. No AGENTS.md has ever been tracked in this repo; ignoring them keeps
# `git add -A` from sweeping tool output into a feature branch.
apps/web/AGENTS.md
apps/web/CLAUDE.md

# Mimosa security-scan local output (scanner working dirs, not source)
.mimosa/

# ZCode local workspace state
.zcode/
