{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Preview-only Epic 1.1 spike Worker. Distinct name from `manut` / edge.
  // DELETE-ABLE: remove this app and docs/identity/* when the spike retires.
  "name": "manut-identity-spike-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    // Spike stays stub-only until ops provisions a real preview Identity D1.
    "IDENTITY_SPIKE_MODE": "stub",
    "BETTER_AUTH_PINNED_VERSION": "1.6.23",
  },
  // FAIL CLOSED: do not invent D1 / Hyperdrive ids. Keep bindings empty until
  // Manut-owned preview resources exist. Shape (do not invent an id in-repo):
  // "d1_databases": [{
  //   "binding": "IDENTITY_DB",
  //   "database_name": "<manut-identity-preview-name>",
  //   "database_id": "<manut-identity-preview-id>"
  // }]
  "d1_databases": [],
  // Identity Worker must not bind Hyperdrive (Postgres strangler stays on edge).
  "hyperdrive": [],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
}
