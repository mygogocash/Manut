{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "types": [
      "@cloudflare/vitest-pool-workers/types",
      "@cloudflare/workers-types",
      "vitest/globals"
    ]
  },
  "include": [
    "scripts/**/*.d.mts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "worker-configuration.d.ts"
  ]
}
