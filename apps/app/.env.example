# Public routing metadata only. Use fresh Manut-owned environments.
EXPO_PUBLIC_API_URL=https://api.example.invalid/api
# Optional: Express origin (or full /messages namespace) for live messaging fallback.
# When unset, derived from EXPO_PUBLIC_API_URL (strips a trailing /api).
EXPO_PUBLIC_SOCKET_URL=https://api.example.invalid
# Optional: edge Worker origin for Durable Object shared-channel WebSockets.
# Web defaults to same-origin; native should set this when the edge host differs.
EXPO_PUBLIC_REALTIME_ORIGIN=
EXPO_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-fresh-public-anon-key

# Only public client configuration belongs in this file.
