{
  "expo": {
    "name": "Manut Intranet",
    "slug": "manut-intranet",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "manut-intranet",
    "userInterfaceStyle": "automatic",
    "plugins": ["expo-router", "expo-secure-store", "expo-splash-screen"],
    "ios": {
      "bundleIdentifier": "xyz.manut.intranet",
      "supportsTablet": true
    },
    "android": {
      "package": "xyz.manut.intranet"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
