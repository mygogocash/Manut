{
  "name": "@manut/app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:web": "expo start --web",
    "build": "expo export --platform web --output-dir dist",
    "export:web": "expo export --platform web --output-dir dist",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "export:android": "expo export --platform android --output-dir dist-android",
    "serve": "expo serve",
    "lint": "expo lint --max-warnings=0",
    "type-check": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@manut/app-core": "workspace:*",
    "@manut/ui": "workspace:*",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "2.110.7",
    "@tanstack/react-query": "5.101.2",
    "expo": "~57.0.7",
    "expo-constants": "~57.0.6",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "socket.io-client": "4.8.3"
  },
  "devDependencies": {
    "@babel/traverse": "7.29.7",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.17",
    "eslint": "9.39.4",
    "eslint-config-expo": "57.0.0",
    "jest": "29.7.0",
    "jest-expo": "~57.0.2",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3"
  }
}
