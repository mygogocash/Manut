{
  "name": "@manut/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "echo 'API uses tsx for runtime, no build needed'",
    "start": "tsx src/main.ts",
    "lint": "eslint src/ --max-warnings=0",
    "lint:fix": "eslint src/ --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@manut/database": "workspace:*",
    "@manut/types": "workspace:*",
    "@manut/utils": "workspace:*",
    "@supabase/supabase-js": "2.110.7",
    "@types/express-serve-static-core": "5.1.2",
    "compression": "^1.8.0",
    "cookie": "2.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "8.5.2",
    "google-auth-library": "10.9.0",
    "helmet": "8.3.0",
    "jszip": "^3.10.1",
    "multer": "^2.2.0",
    "node-qpdf2": "^6.0.0",
    "officecrypto-tool": "^0.0.19",
    "officeparser": "7.3.0",
    "pdf-lib": "^1.17.1",
    "posthog-node": "5.44.0",
    "socket.io": "^4.8.3",
    "tsx": "4.23.1",
    "winston": "^3.17.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@manut/eslint-config": "workspace:*",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "2.2.0",
    "@types/node": "24.13.3",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.4",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
