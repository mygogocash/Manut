# Dedicated E2E project only: manut-intranet-e2e.
# These values must never point at staging or production.
E2E_SUPABASE_URL=https://your-e2e-project.supabase.co
E2E_SUPABASE_ANON_KEY=your-e2e-public-anon-key
E2E_SUPABASE_SERVICE_ROLE_KEY=your-e2e-server-only-service-role-key
E2E_DATABASE_URL=postgresql://postgres.project:password@pooler.example:6543/postgres?pgbouncer=true
E2E_DIRECT_URL=postgresql://postgres.project:password@pooler.example:5432/postgres
