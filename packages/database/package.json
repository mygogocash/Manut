{
  "name": "@nexora/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:migrate:resolve-init": "dotenv -e ../../.env -- prisma migrate resolve --applied 0000_init",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:push:staging": "dotenv -e ../../.env -- prisma db push --accept-data-loss",
    "db:push:reset": "dotenv -e ../../.env -- prisma db push --force-reset",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:orchestrator": "tsx prisma/seed-orchestrator.ts",
    "db:seed:prod": "tsx prisma/seed-prod.ts",
    "db:reset": "dotenv -e ../../.env -- prisma db push --force-reset && tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:rls": "tsx scripts/apply-rls.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
