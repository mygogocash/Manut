// Per-user CRM update notifications. Written when a CRM task changes status,
// is (re)assigned, or gets a comment — for the task owner/assignees + an
// admin-configured list, minus the actor. Surfaced in the notification bell +
// emailed. `module` discriminates the source CRM (it | general | product |
// legal | accounting | hr | qa | marketing | sales | sales-revenue) so one
// table + one cron + one bell read serve every CRM. IDs are plain columns (no
// FK relations) to keep the User/Project graph untouched, matching the
// PartnerTaskResource.createdBy precedent; deleting a user/project leaves a
// harmless orphan row that ages out of the bell window.
model CrmNotification {
  id        String    @id @default(uuid()) @db.Uuid
  module    String    @default("it")
  userId    String    @map("user_id") @db.Uuid
  type      String // "task_status" | "task_assigned" | "task_comment"
  title     String
  body      String?   @db.Text
  linkUrl   String?   @map("link_url")
  projectId String?   @map("project_id")
  taskId    String?   @map("task_id") @db.Uuid
  actorId   String?   @map("actor_id") @db.Uuid
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("crm_notifications")
}

