// Per-user CRM update notifications. Written when a CRM task changes status,
// is (re)assigned, or gets a comment — for the task owner/assignees + an
// admin-configured list, minus the actor. Surfaced in the notification bell +
// emailed. `module` discriminates the source CRM (it | general | product |
// legal | accounting | hr | qa | marketing | sales | sales-revenue) so one
// table + one cron + one bell read serve every CRM. IDs are plain columns (no
// FK relations) to keep the User/Project graph untouched, matching the
// PartnerTaskResource.createdBy precedent; deleting a user/project leaves a
// harmless orphan row that ages out of the bell window.
model CrmNotification {
  id        String    @id @default(uuid()) @db.Uuid
  module    String    @default("it")
  userId    String    @map("user_id") @db.Uuid
  type      String // "task_status" | "task_assigned" | "task_comment"
  title     String
  body      String?   @db.Text
  linkUrl   String?   @map("link_url")
  projectId String?   @map("project_id")
  taskId    String?   @map("task_id") @db.Uuid
  actorId   String?   @map("actor_id") @db.Uuid
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("crm_notifications")
}

// ─── QA CRM workspace ───────────────────────────────────────
//
// Phase 1 of the QA CRM standalone workspace (Option A per-CRM
// schema isolation, 2026-05-26). Same template as IT/Partner —
// project + member + column + task + comment + assignee — but the
// Task model extends with the QA team's Excel template fields:
// issueDate, product, issueType, observation, expectation, eta,
// qaComment. Priority enum is `P0|P1|P2`; status enum mirrors the
// seeded column keys `open|clarified|exception|closed`.
//
// No data copy in Phase 1 — QA CRM is greenfield, no shared
// `projects WHERE team='qa'` rows to migrate. The `eta` field is
// free-form text per the team's existing template (not validated
// as a date).

model QaProject {
  id          String    @id @default(cuid())
  name        String
