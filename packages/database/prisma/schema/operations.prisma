model ProductProjectTaskAssignee {
  id            String   @id @default(uuid()) @db.Uuid
  taskId        String   @map("task_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  allocationPct Int?     @map("allocation_pct")
  createdAt     DateTime @default(now()) @map("created_at")

  task ProductProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User               @relation("ProductProjectTaskAssigneeUser", fields: [userId], references: [id], onDelete: Cascade)

