model Partner {
  id            String    @id @default(cuid())
  slug          String    @unique
  company       String
  type          String
  status        String    @default("prospect")
  region        String?
  country       String?
  website       String?
  description   String?
  contractValue Decimal?  @map("contract_value") @db.Decimal(15, 2)
  contractStart DateTime? @map("contract_start") @db.Date
  contractEnd   DateTime? @map("contract_end") @db.Date
  notes         String?
  // Partner CRM list layout mirrors the Projects dashboard (#534).
  // These columns drive the same "roll-out tracking" view the BD team
  // uses for projects, scoped to a partnership instead of a project.
  productionLiveDate DateTime? @map("production_live_date") @db.Date
  goLiveDate         DateTime? @map("go_live_date") @db.Date
  revisedGoLiveDate  DateTime? @map("revised_go_live_date") @db.Date
  // Marketing CRM — campaign cadence shown + inline-edited on the
  // overview. `past` = most recent campaign, `next` = upcoming one.
  pastCampaignDate   DateTime? @map("past_campaign_date") @db.Date
  nextCampaignDate   DateTime? @map("next_campaign_date") @db.Date
  dependency         String?
  comment            String?
  // Manual ordering (drag-to-reorder on /partners). Lower values first;
  // createdAt is the deterministic tie-breaker.
  sortOrder  Int     @default(0) @map("sort_order")
  // Relationship / account manager. Free of any business-logic gating
  // (any active user is selectable); when set, surfaces in the
  // Owner column on the list view.
  ownerId    String? @map("owner_id") @db.Uuid
  // Owning department — drawn from the same whitelist as Project
  // department so HR / BD / Marketing can share filters across modules.
  department String?
  // `primaryProjectId` was dropped in Phase 4b of the Partner ↔
  // Project decouple (2026-05-26). Partner CRM now owns its native
  // `partner_*` workspace; the redirect-shim that needed this FK
  // was retired in Phase 4a (#607).
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  contacts PartnerContact[]
  // Optional many-to-one back-link for BD reporting (which projects
  // mention this partner). No cascade — deleting a Project sets the
  // FK on the Project side to NULL, not the Partner here.
  projects Project[]      @relation("PartnerProjects")
  // Marketing-team incident (Darpan, 2026-05-26): the redirect-shim
  // architecture (#576) caused a delete-from-/projects to cascade
  // and wipe Marketing's Partner-side WIP. Phase 1 of the decouple
  // adds Partner-native task tables; Phase 2+ migrates the UI off
  // the redirect. Existing `primaryProjectId` link stays for now
  // so the legacy redirect still works during the transition.
  partnerTasks   PartnerTask[]
  partnerColumns PartnerColumn[]
  partnerMembers PartnerMember[]
  deals    Deal[]
  // Sales CRM v2 — soft link to sales accounts (PRD §11.6). Records stay separate.
  crmAccounts Account[] @relation("PartnerAccounts")
  // Sales Revenue CRM — independent parallel soft link.
  revenueAccounts RevenueAccount[] @relation("PartnerRevenueAccounts")
  owner       User?     @relation("PartnerOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([sortOrder])
  @@index([ownerId])
  @@index([department])
  @@map("partners")
}

model PartnerContact {
  id        String  @id @default(uuid()) @db.Uuid
  partnerId String  @map("partner_id")
  name      String
  title     String?
  email     String?
  phone     String?
  isPrimary Boolean @default(false) @map("is_primary")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("partner_contacts")
}

// ─── Partner-native workspace ─────────────────────────────
//
// Phase 1 of the Partner ↔ Project decouple (Marketing incident,
// Darpan, 2026-05-26). These tables let the Partner CRM own its
// own board (tasks / columns / members / comments) without
// reaching through `Partner.primaryProjectId` into the Project
// graph. The redirect-shim from #576 still operates during the
// transition; Phase 2+ migrates the UI off it.
//
// Shape mirrors the equivalent Project tables one-for-one to keep
// the eventual UI port mechanical. Cascade rules: deleting a
// Partner wipes its workspace (intentional — the Partner row is
// the workspace's identity). Member / task / comment cascades
// follow the Project precedent.

model PartnerMember {
  id        String   @id @default(uuid()) @db.Uuid
  partnerId String   @map("partner_id")
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([partnerId, userId])
  @@map("partner_members")
}

model PartnerColumn {
  id        String @id @default(uuid()) @db.Uuid
  partnerId String @map("partner_id")
  key       String
  label     String
  color     String @default("bg-zinc-500")
  sortOrder Int    @default(0) @map("sort_order")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, key])
  @@index([partnerId])
  @@map("partner_columns")
}

model PartnerTask {
  id           String    @id @default(uuid()) @db.Uuid
  partnerId    String    @map("partner_id")
  parentTaskId String?   @map("parent_task_id") @db.Uuid
  title        String
  description  String?
  status       String    @default("todo")
  priority     String    @default("medium")
  ownerId      String?   @map("owner_id") @db.Uuid
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  partner   Partner                @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  owner     User?                  @relation("PartnerTaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  parent    PartnerTask?           @relation("PartnerTaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks  PartnerTask[]          @relation("PartnerTaskSubtasks")
  comments  PartnerTaskComment[]
  assignees PartnerTaskAssignee[]
  resources PartnerTaskResource[]

  @@index([partnerId])
  @@index([parentTaskId])
  @@map("partner_tasks")
}

// File / link attachments on a Marketing-CRM task card (images, docs,
// external links). `kind` = "file" (Supabase storage url) | "link".
// `createdBy` is a plain user id (no relation) to keep the User model
// untouched — the UI only needs the label + url.
model PartnerTaskResource {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  kind      String
  label     String
  url       String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid

  task PartnerTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("partner_task_resources")
}

model PartnerTaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task   PartnerTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User        @relation("PartnerTaskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
  @@map("partner_task_comments")
}

model PartnerTaskAssignee {
  id            String   @id @default(uuid()) @db.Uuid
  taskId        String   @map("task_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  allocationPct Int?     @map("allocation_pct")
  createdAt     DateTime @default(now()) @map("created_at")

  task PartnerTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User        @relation("PartnerTaskAssigneeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@map("partner_task_assignees")
}

model Deal {
  id          String    @id @default(cuid())
  company     String
  contact     String?
  value       Decimal   @db.Decimal(15, 2)
  stage       String    @default("lead")
  probability Int       @default(10)
  closeDate   DateTime? @map("close_date") @db.Date
  type        String?
  country     String?
  notes       String?
  partnerId   String?   @map("partner_id")
  ownerId     String    @map("owner_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  partner Partner? @relation(fields: [partnerId], references: [id])
  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([stage])
  @@map("deals")
}

model Project {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  status      String    @default("not_yet_started")
  ownerId     String    @map("owner_id") @db.Uuid
  partnerId   String?   @map("partner_id")
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  budget      Decimal?  @db.Decimal(15, 2)
  progress    Int       @default(0)
  // Marketing feedback round #2 — admin-defined custom fields. Stored
  // as a JSON array of `{ id, label, value }` objects so each project
  // can attach arbitrary metadata (campaign tag, channel, KPI, etc.)
  // without a schema migration. Tighter typing (date / number / link)
  // is a follow-up.
  customFields Json     @default("[]") @map("custom_fields")
  // BD feedback round #1 (May 2026) — structured roll-out tracking
  // columns the BD team wants to see on the dashboard. These replace
  // the loosely-typed Progress + Due Date columns that were dropped.
  //
  // BD round #2 retyped `production_live` boolean → date so BD can
  // record *when* a project went live in production. `null` = not
  // yet live (replacing the old `false`).
  productionLiveDate DateTime? @map("production_live_date") @db.Date
  goLiveDate         DateTime? @map("go_live_date") @db.Date
  revisedGoLiveDate  DateTime? @map("revised_go_live_date") @db.Date
  // Project-team feedback (2026-06-10) — agreement signing state shown
  // after Rev. GoLive on the Project CRM list. Free-text from a fixed
  // frontend whitelist (`signed` / `not_signed`); null = not set.
  agreement          String?
  dependency         String?
  comment            String?
  // Manual ordering for the list view (BD-driven drag-to-reorder).
  // Lower values render first; ties break on createdAt desc.
  sortOrder         Int       @default(0) @map("sort_order")
  // Owning team. `general` projects live on /projects (BD dashboard),
  // `it` projects live on the IT Helpdesk → Projects tab with the same
  // schema + UI but scoped to IT team visibility. Adding a new team
  // value here means surfacing a matching filter / tab in the UI.
  team        String   @default("general")
  // Owning department — free-form label drawn from the shared
  // `PROJECT_DEPARTMENTS` list (Management / Marketing / HR / etc.).
  // Nullable so existing rows + non-departmental projects stay valid.
  // Tracked alongside `team` so multiple departments can collaborate
  // on the same BD workspace.
  //
  // A project can span several departments (`departments`), but ONE of them is
  // the primary and stays in this scalar column. Keeping it is what lets the
  // dashboard's `groupBy(["department"])`, the list filter and every export go
  // on working unchanged — a scalar list cannot be grouped. `department` is
  // always `departments[0]`; the service keeps the two in step.
  department   String?
  departments  String[] @default([])
  // Legal-team feedback (2026-05-25) — Workstream tags a Legal Task to
  // the broader programme it belongs to (e.g. "Token Launch",
  // "Partnerships", "Compliance"). Free-text for now; promote to a
  // controlled vocabulary if the legal team starts collecting a
  // stable taxonomy. Nullable so non-Legal projects stay valid.
  workstream  String?
  // Legal-team feedback (2026-05-26) — `details` is the long-form
  // narrative the Legal team uses to keep context on a Legal Task
  // (counterparty notes, deal mechanics, link to drive, etc.).
  // Distinct from `description` which is the short summary; this
  // field is the long body. Postgres `TEXT` for unbounded length.
  // Nullable so non-Legal projects stay valid.
  details     String?   @db.Text
  // HR-team feedback (2026-05-26) — HR CRM uses Project rows to track
  // operational HR tasks (visa runs, admin tickets, F&A approvals)
  // rather than long-lived projects. `taskType` is the issue category
  // and `assignedTeam` is the inbox the task should land in. Both are
  // free-text from a fixed whitelist on the frontend; null for
  // non-HR projects.
  taskType     String? @map("task_type")
  assignedTeam String? @map("assigned_team")
  // Auto-assign default for NEW tasks on this project (shared-board CRMs:
  // general / hr / product / legal / accounting). `mode`: none | creator |
  // owner | user; resolved in projects.service.addTask when the creator
  // leaves the assignee blank. IT CRM keeps its own copy on it_projects.
  defaultAssigneeMode String  @default("none") @map("default_assignee_mode")
  defaultAssigneeId   String? @map("default_assignee_id") @db.Uuid
  // Go-live deadline-reminder debounce for shared-board CRMs (general / hr),
  // whose projects live here rather than in a native table. Fired rung markers
  // (e.g. "golive-7", "golive-overdue"); the generalized CRM deadline cron
  // reads/writes these. IT keeps its own copy on it_projects.
  remindersSent      Json      @default("[]") @map("reminders_sent")
  lastReminderSentAt DateTime? @map("last_reminder_sent_at")
  // Approval workflow engine. Kept in a DEDICATED column, separate from the
  // board `status` field, so the existing Kanban / list / dashboard behaviour
  // is completely untouched. `null` = the project is not in the workflow
  // (every pre-existing project), which keeps the Project CRM backward
  // compatible. Values: draft | pending_pm_approval |
  // pending_business_head_approval | pending_product_admin_approval |
  // pending_development | completed | rejected.
  workflowStatus    String?   @map("workflow_status")
  workflowUpdatedAt DateTime? @map("workflow_updated_at") @db.Timestamptz(6)
  // Whom the Project Manager escalated to, when the status is
  // `pending_escalation`. A named person rather than a role: who needs to sign
  // off varies per request, so the target is data on the row instead of another
  // stage in the machine. Plain scalar, not a relation — avoids a third
  // Project->User relation alongside `owner` and `defaultAssignee`.
  escalatedToId     String?   @map("escalated_to_id") @db.Uuid
  // Which stage of the configured approval chain this request is waiting at,
  // 1..N. Null on every project that predates configurable chains, and on
  // anything not in the workflow, so the coded single-PM behaviour still reads
  // correctly. `workflowStatus` still says WHAT the request is doing;
  // this says WHERE in the chain it is. See approval-chains.prisma.
  currentStepOrder  Int?      @map("current_step_order")
  // Request priority, surfaced to approvers in the notification emails.
  // Nullable — pre-existing projects read as "Normal". low|normal|high|urgent.
  priority          String?
  // Archived by the Project Manager (workflow owner). Archived projects are
  // read-only for every role. Null = active.
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  owner      User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  partner    Partner?           @relation("PartnerProjects", fields: [partnerId], references: [id])
  tasks      ProjectTask[]
  members    ProjectMember[]
  columns    ProjectColumn[]
  milestones ProjectMilestone[]
  // Immutable, append-only history of every workflow transition.
  workflowTransitions ProjectWorkflowTransition[]
  // Delivery log for every approval email raised by this project.
  workflowEmails      ProjectWorkflowEmail[]
  // Change requests raised against this project. See proposals.prisma.
  proposals           Proposal[]
  // Snapshot of the approval chain taken when this request was submitted.
  approvalDecisions   ApprovalChainDecision[]

  @@index([sortOrder])
  @@index([team])
  @@index([department])
  @@index([workflowStatus])
  @@index([archivedAt])
  @@map("projects")
}

// Approval-workflow transition log. Append-only: one row per state change,
// written inside the same transaction as the status update so a project can
// never change state without a corresponding history entry.
model ProjectWorkflowTransition {
  id         String   @id @default(cuid())
  projectId  String   @map("project_id")
  // `null` on the very first transition (project entering the workflow).
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  // Plain audit scalar (no relation) — avoids a second Project->User relation
  // alongside the existing `owner`.
  actorId    String?  @map("actor_id") @db.Uuid
  // Mandatory on reject, optional otherwise.
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_workflow_transitions")
}

// Delivery log for approval-workflow emails. One row per (transition,
// recipient, kind). `idempotencyKey` is UNIQUE and is claimed BEFORE the send
// is attempted, so a replayed or concurrent trigger can never deliver the same
// notification twice. Also the retry ledger: `attempts` / `error` record what
// happened, and a row left in `pending` or `failed` is safe to retry.
model ProjectWorkflowEmail {
  id             String    @id @default(cuid())
  projectId      String    @map("project_id")
  // The transition that raised this email; null for reminders.
  transitionId   String?   @map("transition_id")
  // Workflow stage the email concerns, e.g. pending_pm_approval.
  stage          String
  // approval_request | decision_notice | completion_notice
  kind           String
  recipient      String
  subject        String
  // pending | sent | failed
  status         String    @default("pending")
  attempts       Int       @default(0)
  error          String?   @db.Text
  idempotencyKey String    @unique @map("idempotency_key")
  createdAt      DateTime  @default(now()) @map("created_at")
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([status])
  @@map("project_workflow_emails")
}

model ProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id")
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model ProjectColumn {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id")
  key       String
  label     String
  color     String @default("bg-zinc-500")
  sortOrder Int    @default(0) @map("sort_order")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@index([projectId])
  @@map("project_columns")
}

model ProjectTask {
  id           String    @id @default(uuid()) @db.Uuid
  projectId    String    @map("project_id")
  milestoneId  String?   @map("milestone_id") @db.Uuid
  parentTaskId String?   @map("parent_task_id") @db.Uuid
  title        String
  description  String?
  status       String    @default("todo")
  priority     String    @default("P1")
  ownerId      String?   @map("owner_id") @db.Uuid
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  sortOrder    Int       @default(0) @map("sort_order")
  // Task-deadline reminder debounce ladder. The generalized CRM cron scans
  // project_tasks WHERE project.team IN the enabled board CRMs (it / general /
  // hr …). Fired rung markers, e.g. "due-3" / "due-overdue"; keeps the daily
  // cron idempotent.
  remindersSent Json     @default("[]") @map("reminders_sent")
  lastReminderSentAt DateTime? @map("last_reminder_sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  project      Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone    ProjectMilestone?        @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  owner        User?                    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  parent       ProjectTask?             @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     ProjectTask[]            @relation("TaskSubtasks")
  comments     ProjectTaskComment[]
  activities   ProjectTaskActivity[]
  assignees    ProjectTaskAssignee[]
  dependencies ProjectTaskDependency[]  @relation("DependentTask")
  dependents   ProjectTaskDependency[]  @relation("BlockingTask")
  resources    ProjectTaskResource[]

  @@index([projectId])
  @@index([parentTaskId])
  @@index([milestoneId])
  @@map("project_tasks")
}

model ProjectTaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task   ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User        @relation("ProjectTaskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("project_task_comments")
}

model ProjectTaskActivity {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  kind      String
  field     String?
  oldValue  String?  @map("old_value") @db.Text
  newValue  String?  @map("new_value") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  task  ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User        @relation("ProjectTaskActivityActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("project_task_activities")
}

model ProjectMilestone {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id")
  title       String
  description String?
  // `not_started` | `in_progress` | `done` | `blocked`
  status      String    @default("not_started")
  ownerId     String?   @map("owner_id") @db.Uuid
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User?         @relation("ProjectMilestoneOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks   ProjectTask[]

  @@index([projectId])
  @@map("project_milestones")
}

model ProjectTaskAssignee {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  // 0..100 — capacity planning. `null` = unspecified.
  allocationPct Int?    @map("allocation_pct")
  createdAt    DateTime @default(now()) @map("created_at")

  task ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User        @relation("ProjectTaskAssigneeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("project_task_assignees")
}

model ProjectTaskDependency {
  id              String   @id @default(uuid()) @db.Uuid
  // `taskId` is blocked by `dependsOnTaskId`. UI label maps:
  //   blocking    = SELECT … WHERE depends_on_task_id = :id  (tasks I block)
  //   blocked_by  = SELECT … WHERE task_id = :id             (tasks blocking me)
  taskId          String   @map("task_id") @db.Uuid
  dependsOnTaskId String   @map("depends_on_task_id") @db.Uuid
  // `finish_to_start` (default) | `start_to_start` | `finish_to_finish` | `start_to_finish`
  type            String   @default("finish_to_start")
  createdAt       DateTime @default(now()) @map("created_at")

  task          ProjectTask @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask ProjectTask @relation("BlockingTask",  fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

