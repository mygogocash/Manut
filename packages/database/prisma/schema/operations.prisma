// ─── Product CRM workspace ────────────────────────────────────
//
// Phase 1 of the Product CRM standalone workspace (Option A per-CRM
// schema isolation, 2026-05-26). Same template as IT/Legal/QA/Partner.

model ProductProject {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  description        String?
  status             String    @default("not_yet_started")
  ownerId            String    @map("owner_id") @db.Uuid
  startDate          DateTime? @map("start_date") @db.Date
  endDate            DateTime? @map("end_date") @db.Date
  productionLiveDate DateTime? @map("production_live_date") @db.Date
  goLiveDate         DateTime? @map("go_live_date") @db.Date
  revisedGoLiveDate  DateTime? @map("revised_go_live_date") @db.Date
  dependency         String?
  comment            String?
  sortOrder          Int       @default(0) @map("sort_order")
  department         String?
  // Auto-assign default for NEW tasks (Phase C pt3). `mode`: none|creator|
  // owner|user; resolved in projects.service.addTask (team='product') from
  // THIS native row, not the shared mirror (which never copies these).
  defaultAssigneeMode String  @default("none") @map("default_assignee_mode")
  defaultAssigneeId   String? @map("default_assignee_id") @db.Uuid
  // Go-live deadline-reminder debounce ladder (Phase C pt3). The generalized
  // CRM cron scans this native table directly (the shared mirror is lazy +
  // never carries these), fired rung markers e.g. "golive-7"/"golive-overdue".
  remindersSent      Json      @default("[]") @map("reminders_sent")
  lastReminderSentAt DateTime? @map("last_reminder_sent_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  archivedAt  DateTime? @map("archived_at")
  owner   User                   @relation("ProductProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members ProductProjectMember[]
  columns ProductProjectColumn[]
  tasks   ProductProjectTask[]

  @@index([sortOrder])
  @@index([department])
  @@index([archivedAt])
  @@map("product_projects")
}

model ProductProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id")
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")

  project ProductProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User           @relation("ProductProjectMembership", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("product_project_members")
}

model ProductProjectColumn {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id")
  key       String
  label     String
  color     String @default("bg-zinc-500")
  sortOrder Int    @default(0) @map("sort_order")

  project ProductProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@index([projectId])
  @@map("product_project_columns")
}

model ProductProjectTask {
  id           String    @id @default(uuid()) @db.Uuid
  projectId    String    @map("project_id")
  parentTaskId String?   @map("parent_task_id") @db.Uuid
  title        String
  description  String?
  status       String    @default("todo")
  priority     String    @default("medium")
  ownerId      String?   @map("owner_id") @db.Uuid
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  project   ProductProject               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner     User?                        @relation("ProductProjectTaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  parent    ProductProjectTask?          @relation("ProductProjectTaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks  ProductProjectTask[]         @relation("ProductProjectTaskSubtasks")
  comments  ProductProjectTaskComment[]
