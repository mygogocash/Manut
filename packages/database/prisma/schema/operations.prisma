model Office {
  id       String  @id @default(cuid())
  name     String
  address  String?
  city     String
  country  String
  timezone String?
  capacity Int     @default(0)
  isActive Boolean @default(true) @map("is_active")

  desks  OfficeDesk[]
  rooms  MeetingRoom[]
  assets Asset[]

  @@map("offices")
}

model OfficeDesk {
  id       String  @id @default(uuid()) @db.Uuid
  officeId String  @map("office_id")
  name     String
  floor    String?
  zone     String?
  isActive Boolean @default(true) @map("is_active")

  office   Office        @relation(fields: [officeId], references: [id])
  bookings DeskBooking[]

  @@map("office_desks")
}

model DeskBooking {
  id         String   @id @default(uuid()) @db.Uuid
  deskId     String   @map("desk_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  date       DateTime @db.Date
  createdAt  DateTime @default(now()) @map("created_at")

  desk     OfficeDesk @relation(fields: [deskId], references: [id])
  employee User       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([deskId, date])
  @@map("desk_bookings")
}

model MeetingRoom {
  id        String  @id @default(uuid()) @db.Uuid
  officeId  String  @map("office_id")
  name      String
  capacity  Int     @default(0)
  amenities String?
  // Public preview image (Supabase `uploads` bucket). HR feedback (May
  // 2026) — staff want to see what the room looks like before booking.
  imageUrl  String? @map("image_url")
  isActive  Boolean @default(true) @map("is_active")

  office   Office        @relation(fields: [officeId], references: [id])
  bookings RoomBooking[]

  @@map("meeting_rooms")
}

model RoomBooking {
  id             String   @id @default(uuid()) @db.Uuid
  roomId         String   @map("room_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  date           DateTime @db.Date
  // "HH:MM" start. Bookings now support arbitrary 15 / 30 / 60 min
  // durations — the closing slot is held on `endTime`. Legacy hourly
  // rows were backfilled to `endTime = timeSlot + 60min`.
  timeSlot       String   @map("time_slot")
  endTime        String?  @map("end_time")
  title          String?
  // Brief description of the conference / meeting purpose. Separate from
  // `title` so the UI can render a one-line label and a longer note.
  description    String?
  // Headcount — validated against MeetingRoom.capacity at booking time.
  attendeesCount Int?     @map("attendees_count")
  // Multi-day bookings get split into one row per day sharing this
  // UUID. Single-day reservations stay `null`. Used to bulk-cancel
  // and to render the "spans N days" hint on the detail dialog.
  seriesId       String?  @map("series_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  room     MeetingRoom @relation(fields: [roomId], references: [id])
  employee User        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([roomId, date])
  @@index([seriesId])
  @@map("room_bookings")
}

model Asset {
  id           String    @id @default(uuid()) @db.Uuid
  officeId     String    @map("office_id")
  name         String
  // Canonical category ("laptop" / "mobile" / "monitor" / "peripheral" /
  // "usb_accessory" / "software" / "furniture" / "other"). Kept on the
  // existing `type` column to avoid renaming — UI maps labels.
  type         String
  serialNo     String?   @map("serial_no")
  assignedTo   String?   @map("assigned_to") @db.Uuid
  purchaseDate DateTime? @map("purchase_date") @db.Date
  purchaseCost Decimal?  @map("purchase_cost") @db.Decimal(15, 2)
  status       String    @default("available")
  notes        String?

  /// Who it was bought FROM, which is not who made it. A fixed-asset register
  /// is audited on the purchase, so the retailer ("Index Living Mall", "IKANO")
  /// is the field that gets asked about; `manufacturer` below stays the maker.
  supplier          String?

  // Hardware metadata (from the IT-asset-template spreadsheet).
  manufacturer      String?
  model             String?
  colour            String?
  subType           String?   @map("sub_type")
  operatingSystem   String?   @map("operating_system")
  description       String?
  supportLink       String?   @map("support_link")
  activeServiceDate DateTime? @map("active_service_date") @db.Date
  department        String?
  // Sticker / QR code printed on the asset. Generated as
  // `<serialNo>-<YYYYMMDD>` when blank, but writeable so finance can
  // override with their own asset-register code.
  assetCode    String? @map("asset_code")
  // Software-specific (folded into Asset for v1; carve out into a
  // SoftwareLicense model later if licensing/seat tracking lands).
  version      String?
  /// Photo of the asset. Held in the PUBLIC `uploads` bucket so a thumbnail
  /// renders straight from the URL — a private bucket would need a signed URL
  /// minted per row, which is a request per asset on every list render.
  imageUrl     String? @map("image_url")

  // Furniture metadata. A desk has no serial number, no manufacturer support
  // page and no operating system; what identifies it is what it is made of,
  // how big it is, what condition it is in and which room it is standing in.
  material       String?
  /// Free text rather than three numeric columns: catalogues quote sizes in
  /// wildly different forms ("W120 x D60 x H75 cm", "Ø90 cm", "2-seater") and
  /// forcing them into L/W/H loses the ones that do not fit.
  dimensions     String?
  /// new | good | fair | poor — validated in Zod, not a DB enum, so facilities
  /// can extend the ladder without a migration.
  condition      String?
  /// Where it physically is inside the office ("Meeting Room 2, 3rd floor").
  /// officeId says which building; furniture moves around inside one.
  locationDetail String?   @map("location_detail")
  warrantyUntil  DateTime? @map("warranty_until") @db.Date

  // Accounting / fixed-asset register fields.
  quantity         Int      @default(1)
  usefulLifeMonths Int?     @map("useful_life_months")
  bookValue        Decimal? @map("book_value") @db.Decimal(15, 2)
  disposalDate     DateTime? @map("disposal_date") @db.Date
  sellingPrice     Decimal? @map("selling_price") @db.Decimal(15, 2)

  office   Office @relation(fields: [officeId], references: [id])
  assignee User?  @relation(fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([status])
  @@index([assetCode])
  @@map("assets")
}

// ── Voucher CRM ──────────────────────────────────────────
// Flat per-partner voucher ledger (Redeemed / Issued / Refund).
// Unlike the project-workspace CRMs this is a single table; the UI
// shows a grand-total row summing each numeric column server-side.
model VoucherEntry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partner   String   @db.VarChar(200)
  country   String?  @db.VarChar(120)
  redeemed  Int      @default(0)
  issued    Int      @default(0)
  refund    Int      @default(0)
  sortOrder Int      @default(0) @map("sort_order")
  addedBy   String?  @map("added_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator User? @relation("VoucherEntryCreator", fields: [addedBy], references: [id], onDelete: SetNull)

  archivedAt  DateTime? @map("archived_at")
  @@index([partner])
  @@index([archivedAt])
  @@map("voucher_entries")
}

// OneWave marketing-campaign CRM. Feeds the OW Dashboard alongside the
// synced traction sheet: marketing logs upcoming campaigns here with the
// lever sequence, copy + banner designs (rich text w/ inline uploaded
// images), and a prediction spreadsheet (xlsx in the private `documents`
// bucket, fetched via a signed-URL download route).
model MarketingCampaign {
  id                 String   @id @default(uuid()) @db.Uuid
  title              String   @db.VarChar(300)
  campaignDate       DateTime @map("campaign_date") @db.Date
  // Campaign duration in hours (fractional allowed, e.g. 1.5).
  hours              Float?
  // Levers Pulled (sequence) — free rich text describing the push /
  // in-app banner cadence.
  leversPulled       String?  @map("levers_pulled")
  // Copy + banner designs — rich-text HTML with inline uploaded images.
  copyDesign         String?  @map("copy_design")
  // Prediction spreadsheet (xlsx) forecasting traffic for the campaign.
  predictionFileUrl  String?  @map("prediction_file_url")
  predictionFileName String?  @map("prediction_file_name")
  status             String   @default("planned") @db.VarChar(20)
  sortOrder          Int      @default(0) @map("sort_order")
  addedBy            String?  @map("added_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  creator User? @relation("MarketingCampaignCreator", fields: [addedBy], references: [id], onDelete: SetNull)

  @@index([campaignDate])
  @@map("marketing_campaigns")
}

/// OneWave holistic dashboard (2026-06-11) — one normalized daily metric
/// row per (date, telco), written by the /api/cron/ow-snapshot-refresh
/// job from the multi-tab OW2.0 traction sheet. The deterministic facts
/// layer; the dashboard + AI narrative read from here, never re-parse the
/// sheet inline.
model OwDailyMetric {
  id              String   @id @default(uuid()) @db.Uuid
  date            DateTime @db.Date
  telco           String   @db.VarChar(20) // gopay|dialog|ryze|...|all
  homepageViews   Int?     @map("homepage_views")
  dauCrm          Int?     @map("dau_crm")
  dauGa           Int?     @map("dau_ga")
  mauRolling30    Int?     @map("mau_rolling_30")
  uniqueUsers     Int?     @map("unique_users")
  newUsers        Int?     @map("new_users")
  repeatUsers     Int?     @map("repeat_users")
  avgSessionSec   Int?     @map("avg_session_sec")
  stwWins         Int?     @map("stw_wins")
  clicksBnryGames Int?     @map("clicks_bnry_games")
  accessPassUsers Int?     @map("access_pass_users")
  bnryEarned      BigInt?  @map("bnry_earned")
  bnryRedeemed    BigInt?  @map("bnry_redeemed")
  mauNexus         Int?    @map("mau_nexus")
  newUsersGa       Int?    @map("new_users_ga")
  repeatUsersGa    Int?    @map("repeat_users_ga")
  sessionsGa       Int?    @map("sessions_ga")
  totalCredit      BigInt? @map("total_credit")
  totalDebit       BigInt? @map("total_debit")
  totalTransactions Int?   @map("total_transactions")
  spinUsage        Int?    @map("spin_usage")
  spinWinTokens    BigInt? @map("spin_win_tokens")
  uniqueSpinUsers  Int?    @map("unique_spin_users")
  usersFando       Int?    @map("users_fando")
  usersNgage       Int?    @map("users_ngage")
  txMetrics        Json?   @map("tx_metrics")
  isAnomaly       Boolean  @default(false) @map("is_anomaly")
  isIntraday      Boolean  @default(false) @map("is_intraday")
  sourceTab       String?  @map("source_tab") @db.VarChar(120)
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([date, telco])
  @@index([telco, date])
  @@map("ow_daily_metrics")
}

/// Latest computed holistic dashboard payload + (later) AI narrative.
/// Upserted by the snapshot cron; the dashboard reads the most recent row
/// rather than recomputing inline. `narrative` stays null until the P3 AI
/// layer lands.
model OwSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  payload     Json
  narrative   Json?
  generatedAt DateTime @default(now()) @map("generated_at")

  @@index([generatedAt(sort: Desc)])
  @@map("ow_snapshots")
}
