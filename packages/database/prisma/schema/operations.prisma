model Partner {
  id                 String    @id @default(cuid())
  slug               String    @unique
  company            String
  type               String
  status             String    @default("prospect")
  region             String?
  country            String?
  website            String?
  description        String?
  contractValue      Decimal?  @map("contract_value") @db.Decimal(15, 2)
  contractStart      DateTime? @map("contract_start") @db.Date
  contractEnd        DateTime? @map("contract_end") @db.Date
  notes              String?
  // Partner CRM list layout mirrors the Projects dashboard.
  // These columns drive the same "roll-out tracking" view the sales team
  // uses for projects, scoped to a partnership instead of a project.
  productionLiveDate DateTime? @map("production_live_date") @db.Date
  goLiveDate         DateTime? @map("go_live_date") @db.Date
  revisedGoLiveDate  DateTime? @map("revised_go_live_date") @db.Date
  // Marketing CRM — campaign cadence shown + inline-edited on the
  // overview. `past` = most recent campaign, `next` = upcoming one.
  pastCampaignDate   DateTime? @map("past_campaign_date") @db.Date
  nextCampaignDate   DateTime? @map("next_campaign_date") @db.Date
  dependency         String?
  comment            String?
  // Manual ordering (drag-to-reorder on /partners). Lower values first;
  // createdAt is the deterministic tie-breaker.
  sortOrder          Int       @default(0) @map("sort_order")
  // Relationship / account manager. Free of any business-logic gating
  // (any active user is selectable); when set, surfaces in the
  // Owner column on the list view.
  ownerId            String?   @map("owner_id") @db.Uuid
  // Owning department — drawn from the same whitelist as Project
  // department so HR / BD / Marketing can share filters across modules.
  department         String?
  // Partner CRM owns its native `partner_*` workspace, so the retired
  // redirect shim no longer needs a primary-project foreign key.
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  contacts        PartnerContact[]
  // Optional many-to-one back-link for BD reporting (which projects
  // mention this partner). No cascade — deleting a Project sets the
  // FK on the Project side to NULL, not the Partner here.
  projects        Project[]        @relation("PartnerProjects")
  // Partner-native task tables prevent project deletion from cascading
  // into an independently owned partner workspace.
  partnerTasks    PartnerTask[]
  partnerColumns  PartnerColumn[]
  partnerMembers  PartnerMember[]
  deals           Deal[]
  // Sales CRM soft link to sales accounts. Records stay separate.
  crmAccounts     Account[]        @relation("PartnerAccounts")
  // Sales Revenue CRM — independent parallel soft link.
  revenueAccounts RevenueAccount[] @relation("PartnerRevenueAccounts")
  owner           User?            @relation("PartnerOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([sortOrder])
  @@index([ownerId])
  @@index([department])
  @@map("partners")
}

model PartnerContact {
  id        String  @id @default(uuid()) @db.Uuid
  partnerId String  @map("partner_id")
  name      String
  title     String?
  email     String?
  phone     String?
  isPrimary Boolean @default(false) @map("is_primary")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("partner_contacts")
}

// ─── Partner-native workspace ─────────────────────────────
//
// These tables let the Partner CRM own its
// own board (tasks / columns / members / comments) without
// reaching through `Partner.primaryProjectId` into the Project
// graph.
//
// Shape mirrors the equivalent Project tables one-for-one to keep
// the eventual UI port mechanical. Cascade rules: deleting a
// Partner wipes its workspace (intentional — the Partner row is
// the workspace's identity). Member / task / comment cascades
// follow the Project precedent.

model PartnerMember {
  id        String   @id @default(uuid()) @db.Uuid
  partnerId String   @map("partner_id")
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([partnerId, userId])
  @@map("partner_members")
}

model PartnerColumn {
  id        String @id @default(uuid()) @db.Uuid
  partnerId String @map("partner_id")
  key       String
  label     String
  color     String @default("bg-zinc-500")
  sortOrder Int    @default(0) @map("sort_order")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, key])
  @@index([partnerId])
  @@map("partner_columns")
}

model PartnerTask {
  id           String    @id @default(uuid()) @db.Uuid
  partnerId    String    @map("partner_id")
  parentTaskId String?   @map("parent_task_id") @db.Uuid
  title        String
  description  String?
  status       String    @default("todo")
  priority     String    @default("medium")
  ownerId      String?   @map("owner_id") @db.Uuid
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  partner   Partner               @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  owner     User?                 @relation("PartnerTaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  parent    PartnerTask?          @relation("PartnerTaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks  PartnerTask[]         @relation("PartnerTaskSubtasks")
  comments  PartnerTaskComment[]
  assignees PartnerTaskAssignee[]
  resources PartnerTaskResource[]

  @@index([partnerId])
  @@index([parentTaskId])
  @@map("partner_tasks")
}

// File / link attachments on a Marketing-CRM task card (images, docs,
// external links). `kind` = "file" (Supabase storage url) | "link".
// `createdBy` is a plain user id (no relation) to keep the User model
// untouched — the UI only needs the label + url.
model PartnerTaskResource {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  kind      String
  label     String
  url       String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid

  task PartnerTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("partner_task_resources")
}

model PartnerTaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task   PartnerTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User        @relation("PartnerTaskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
  @@map("partner_task_comments")
}

model PartnerTaskAssignee {
  id            String   @id @default(uuid()) @db.Uuid
  taskId        String   @map("task_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  allocationPct Int?     @map("allocation_pct")
  createdAt     DateTime @default(now()) @map("created_at")

  task PartnerTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User        @relation("PartnerTaskAssigneeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@map("partner_task_assignees")
}

model Deal {
  id          String    @id @default(cuid())
  company     String
  contact     String?
  value       Decimal   @db.Decimal(15, 2)
  stage       String    @default("lead")
  probability Int       @default(10)
  closeDate   DateTime? @map("close_date") @db.Date
  type        String?
  country     String?
  notes       String?
  partnerId   String?   @map("partner_id")
  ownerId     String    @map("owner_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  partner Partner? @relation(fields: [partnerId], references: [id])
  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([stage])
  @@map("deals")
}

model Project {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  description         String?
  status              String    @default("not_yet_started")
  ownerId             String    @map("owner_id") @db.Uuid
  partnerId           String?   @map("partner_id")
  startDate           DateTime? @map("start_date") @db.Date
  endDate             DateTime? @map("end_date") @db.Date
  budget              Decimal?  @db.Decimal(15, 2)
  progress            Int       @default(0)
  // Admin-defined custom fields. Stored
  // as a JSON array of `{ id, label, value }` objects so each project
  // can attach arbitrary metadata (campaign tag, channel, KPI, etc.)
  // without a schema migration. Tighter typing (date / number / link)
  // is a follow-up.
  customFields        Json      @default("[]") @map("custom_fields")
  // Structured roll-out tracking columns for the project dashboard. These replace
  // the loosely-typed Progress + Due Date columns that were dropped.
  //
  // `production_live` is a date so the dashboard can
  // record *when* a project went live in production. `null` = not
  // yet live (replacing the old `false`).
  productionLiveDate  DateTime? @map("production_live_date") @db.Date
  goLiveDate          DateTime? @map("go_live_date") @db.Date
  revisedGoLiveDate   DateTime? @map("revised_go_live_date") @db.Date
  // Agreement signing state shown
  // after Rev. GoLive on the Project CRM list. Free-text from a fixed
  // frontend whitelist (`signed` / `not_signed`); null = not set.
  agreement           String?
  dependency          String?
  comment             String?
  // Manual ordering for the list view (BD-driven drag-to-reorder).
  // Lower values render first; ties break on createdAt desc.
  sortOrder           Int       @default(0) @map("sort_order")
  // Owning team. `general` projects live on /projects (BD dashboard),
  // `it` projects live on the IT Helpdesk → Projects tab with the same
  // schema + UI but scoped to IT team visibility. Adding a new team
  // value here means surfacing a matching filter / tab in the UI.
  team                String    @default("general")
  // Owning department — free-form label drawn from the shared
  // `PROJECT_DEPARTMENTS` list (Management / Marketing / HR / etc.).
  // Nullable so existing rows + non-departmental projects stay valid.
  // Tracked alongside `team` so multiple departments can collaborate
  // on the same BD workspace.
  department          String?
  // Workstream tags a Legal Task to
  // the broader programme it belongs to (e.g. "Token Launch",
  // "Partnerships", "Compliance"). Free-text for now; promote to a
  // controlled vocabulary if the legal team starts collecting a
  // stable taxonomy. Nullable so non-Legal projects stay valid.
  workstream          String?
  // `details` is the long-form
  // narrative the Legal team uses to keep context on a Legal Task
  // (counterparty notes, deal mechanics, link to drive, etc.).
  // Distinct from `description` which is the short summary; this
  // field is the long body. Postgres `TEXT` for unbounded length.
  // Nullable so non-Legal projects stay valid.
  details             String?   @db.Text
  // HR CRM uses Project rows to track
  // operational HR tasks (visa runs, admin tickets, F&A approvals)
  // rather than long-lived projects. `taskType` is the issue category
  // and `assignedTeam` is the inbox the task should land in. Both are
  // free-text from a fixed whitelist on the frontend; null for
  // non-HR projects.
  taskType            String?   @map("task_type")
  assignedTeam        String?   @map("assigned_team")
  // Auto-assign default for NEW tasks on this project (shared-board CRMs:
  // general / hr / product / legal / accounting). `mode`: none | creator |
  // owner | user; resolved in projects.service.addTask when the creator
  // leaves the assignee blank. IT CRM keeps its own copy on it_projects.
  defaultAssigneeMode String    @default("none") @map("default_assignee_mode")
  defaultAssigneeId   String?   @map("default_assignee_id") @db.Uuid
  // Go-live deadline-reminder debounce for shared-board CRMs (general / hr),
  // whose projects live here rather than in a native table. Fired rung markers
  // (e.g. "golive-7", "golive-overdue"); the generalized CRM deadline cron
  // reads/writes these. IT keeps its own copy on it_projects.
  remindersSent       Json      @default("[]") @map("reminders_sent")
  lastReminderSentAt  DateTime? @map("last_reminder_sent_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  owner      User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  partner    Partner?           @relation("PartnerProjects", fields: [partnerId], references: [id])
  tasks      ProjectTask[]
  members    ProjectMember[]
  columns    ProjectColumn[]
  milestones ProjectMilestone[]

  @@index([sortOrder])
  @@index([team])
  @@index([department])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id")
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model ProjectColumn {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id")
  key       String
  label     String
  color     String @default("bg-zinc-500")
  sortOrder Int    @default(0) @map("sort_order")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@index([projectId])
  @@map("project_columns")
}

model ProjectTask {
  id                 String    @id @default(uuid()) @db.Uuid
  projectId          String    @map("project_id")
  milestoneId        String?   @map("milestone_id") @db.Uuid
  parentTaskId       String?   @map("parent_task_id") @db.Uuid
  title              String
  description        String?
  status             String    @default("todo")
  priority           String    @default("P1")
  ownerId            String?   @map("owner_id") @db.Uuid
  startDate          DateTime? @map("start_date") @db.Date
  endDate            DateTime? @map("end_date") @db.Date
  sortOrder          Int       @default(0) @map("sort_order")
  // Task-deadline reminder debounce ladder. The generalized CRM cron scans
  // project_tasks WHERE project.team IN the enabled board CRMs (it / general /
  // hr …). Fired rung markers, e.g. "due-3" / "due-overdue"; keeps the daily
  // cron idempotent.
  remindersSent      Json      @default("[]") @map("reminders_sent")
  lastReminderSentAt DateTime? @map("last_reminder_sent_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  project      Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone    ProjectMilestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  owner        User?                   @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  parent       ProjectTask?            @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     ProjectTask[]           @relation("TaskSubtasks")
  comments     ProjectTaskComment[]
  activities   ProjectTaskActivity[]
  assignees    ProjectTaskAssignee[]
  dependencies ProjectTaskDependency[] @relation("DependentTask")
  dependents   ProjectTaskDependency[] @relation("BlockingTask")
  resources    ProjectTaskResource[]

  @@index([projectId])
  @@index([parentTaskId])
  @@index([milestoneId])
  @@map("project_tasks")
}

model ProjectTaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task   ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User        @relation("ProjectTaskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("project_task_comments")
}

model ProjectTaskActivity {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  kind      String
  field     String?
  oldValue  String?  @map("old_value") @db.Text
  newValue  String?  @map("new_value") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  task  ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User        @relation("ProjectTaskActivityActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("project_task_activities")
}

model ProjectMilestone {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id")
  title       String
  description String?
  // `not_started` | `in_progress` | `done` | `blocked`
  status      String    @default("not_started")
  ownerId     String?   @map("owner_id") @db.Uuid
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User?         @relation("ProjectMilestoneOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks   ProjectTask[]

  @@index([projectId])
  @@map("project_milestones")
}

model ProjectTaskAssignee {
  id            String   @id @default(uuid()) @db.Uuid
  taskId        String   @map("task_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  // 0..100 — capacity planning. `null` = unspecified.
  allocationPct Int?     @map("allocation_pct")
  createdAt     DateTime @default(now()) @map("created_at")

  task ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User        @relation("ProjectTaskAssigneeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("project_task_assignees")
}

model ProjectTaskDependency {
  id              String   @id @default(uuid()) @db.Uuid
  // `taskId` is blocked by `dependsOnTaskId`. UI label maps:
  //   blocking    = SELECT … WHERE depends_on_task_id = :id  (tasks I block)
  //   blocked_by  = SELECT … WHERE task_id = :id             (tasks blocking me)
  taskId          String   @map("task_id") @db.Uuid
  dependsOnTaskId String   @map("depends_on_task_id") @db.Uuid
  // `finish_to_start` (default) | `start_to_start` | `finish_to_finish` | `start_to_finish`
  type            String   @default("finish_to_start")
  createdAt       DateTime @default(now()) @map("created_at")

  task          ProjectTask @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask ProjectTask @relation("BlockingTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([taskId])
  @@index([dependsOnTaskId])
  @@map("project_task_dependencies")
}

model ProjectTaskResource {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  // `file` (Supabase storage url) | `link` (external) | `doc` (internal docs module ref)
  kind      String
  label     String
  url       String   @db.Text
  // Optional ref to internal docs module entry when `kind = doc`.
  docId     String?  @map("doc_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid

  task    ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  creator User        @relation("ProjectTaskResourceCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("project_task_resources")
}

// ─── IT CRM workspace ───────────────────────────────────────
//
// IT CRM uses a standalone workspace and is moving
// off the shared `projects` table (filtered by `team="it"`) into
// dedicated tables, same template as Partner phases 1-4. MVP shape
// matches Partner: project + member + column + task + comment +
// assignee. Milestones / dependencies / resources / activities /
// custom fields land in Phase 1b if IT users need them.
//
// Cascade rules mirror the Partner workspace: deleting an
// `ItProject` wipes its children; member / task / comment cascades
// follow the same precedent. No cross-module FK — IT CRM rows
// have no relation to Partner, Account, Project, or anything
// outside this graph.

model ItProject {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  description         String?
  status              String    @default("not_yet_started")
  ownerId             String    @map("owner_id") @db.Uuid
  startDate           DateTime? @map("start_date") @db.Date
  endDate             DateTime? @map("end_date") @db.Date
  productionLiveDate  DateTime? @map("production_live_date") @db.Date
  goLiveDate          DateTime? @map("go_live_date") @db.Date
  revisedGoLiveDate   DateTime? @map("revised_go_live_date") @db.Date
  dependency          String?
  comment             String?
  sortOrder           Int       @default(0) @map("sort_order")
  department          String?
  // Intelligence fields for IT CRM dashboard metrics.
  // `statusChangedAt` is stamped whenever `status` changes so the
  // dashboard computes stage-aging / cycle-time directly instead of
  // inferring from `updatedAt` (which any edit bumps). `healthStatus`
  // is a manual RAG rating — "green" | "yellow" | "red" — driving the
  // portfolio heat-map exhibit; null = not yet rated. `effortPoints` is
  // relative sizing (story points / person-days) for velocity + load.
  statusChangedAt     DateTime? @map("status_changed_at")
  healthStatus        String?   @map("health_status")
  effortPoints        Int?      @map("effort_points")
  // Reversible archive (orthogonal to `status`): a set `archivedAt` hides the
  // project from the default IT CRM list (Active tab) while preserving its real
  // status. Null = active. Mirrors the SurveyForm archive convention; NOT the
  // hard-delete path. The dashboard analytics still count archived projects as
  // historical record. Archive state lives on this native row only — it does
  // not propagate to the shared `projects` board mirror.
  archivedAt          DateTime? @map("archived_at")
  // Auto-assign default for NEW tasks on this project (IT CRM only). `mode`
  // decides who a task's owner defaults to when the creator leaves it blank:
  //   none    – no default (current behaviour)
  //   creator – whoever creates the task
  //   owner   – the project owner
  //   user    – the specific `defaultAssigneeId` below
  // Resolved at task-create time in projects.service.addTask (the shared board
  // is the live writer). `defaultAssigneeId` is a plain user id with no FK —
  // matches the PartnerTaskResource.createdBy precedent — so it is validated
  // (must be an active user) before it is applied.
  defaultAssigneeMode String    @default("none") @map("default_assignee_mode")
  defaultAssigneeId   String?   @map("default_assignee_id") @db.Uuid
  // Deadline-reminder debounce ladder. `remindersSent` holds the fired rung
  // markers (e.g. "golive-7", "golive-overdue") so the daily cron is
  // idempotent — re-running the same day is a no-op. Reset to [] in
  // ItCrmService.update() whenever a go-live date is edited, so a slipped
  // deadline re-arms its countdown. See it-crm.reminders.ts.
  remindersSent       Json      @default("[]") @map("reminders_sent")
  lastReminderSentAt  DateTime? @map("last_reminder_sent_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  owner   User              @relation("ItProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members ItProjectMember[]
  columns ItProjectColumn[]
  tasks   ItProjectTask[]

  @@index([sortOrder])
  @@index([department])
  @@index([archivedAt])
  @@map("it_projects")
}

model ItProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id")
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")

  project ItProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User      @relation("ItProjectMembership", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
