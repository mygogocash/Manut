  project   ProductProject               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner     User?                        @relation("ProductProjectTaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  parent    ProductProjectTask?          @relation("ProductProjectTaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks  ProductProjectTask[]         @relation("ProductProjectTaskSubtasks")
  comments  ProductProjectTaskComment[]
  assignees ProductProjectTaskAssignee[]

  @@index([projectId])
  @@index([parentTaskId])
  @@map("product_project_tasks")
}

model ProductProjectTaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task   ProductProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User               @relation("ProductProjectTaskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
  @@map("product_project_task_comments")
}

model ProductProjectTaskAssignee {
  id            String   @id @default(uuid()) @db.Uuid
  taskId        String   @map("task_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  allocationPct Int?     @map("allocation_pct")
  createdAt     DateTime @default(now()) @map("created_at")

  task ProductProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User               @relation("ProductProjectTaskAssigneeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@map("product_project_task_assignees")
}

model Office {
  id       String  @id @default(cuid())
  name     String
  address  String?
  city     String
  country  String
  timezone String?
  capacity Int     @default(0)
  isActive Boolean @default(true) @map("is_active")

  desks  OfficeDesk[]
  rooms  MeetingRoom[]
  assets Asset[]

  @@map("offices")
}

model OfficeDesk {
  id       String  @id @default(uuid()) @db.Uuid
  officeId String  @map("office_id")
  name     String
  floor    String?
  zone     String?
  isActive Boolean @default(true) @map("is_active")

  office   Office        @relation(fields: [officeId], references: [id])
  bookings DeskBooking[]

  @@map("office_desks")
}

model DeskBooking {
  id         String   @id @default(uuid()) @db.Uuid
  deskId     String   @map("desk_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  date       DateTime @db.Date
  createdAt  DateTime @default(now()) @map("created_at")

  desk     OfficeDesk @relation(fields: [deskId], references: [id])
  employee User       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([deskId, date])
  @@map("desk_bookings")
}

model MeetingRoom {
  id        String  @id @default(uuid()) @db.Uuid
  officeId  String  @map("office_id")
  name      String
  capacity  Int     @default(0)
  amenities String?
  // Public preview image (Supabase `uploads` bucket) so staff can see
  // what the room looks like before booking.
  imageUrl  String? @map("image_url")
  isActive  Boolean @default(true) @map("is_active")

  office   Office        @relation(fields: [officeId], references: [id])
  bookings RoomBooking[]

  @@map("meeting_rooms")
}

model RoomBooking {
  id             String   @id @default(uuid()) @db.Uuid
  roomId         String   @map("room_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  date           DateTime @db.Date
  // "HH:MM" start. Bookings now support arbitrary 15 / 30 / 60 min
  // durations — the closing slot is held on `endTime`. Legacy hourly
  // rows were backfilled to `endTime = timeSlot + 60min`.
  timeSlot       String   @map("time_slot")
  endTime        String?  @map("end_time")
  title          String?
  // Brief description of the conference / meeting purpose. Separate from
  // `title` so the UI can render a one-line label and a longer note.
  description    String?
  // Headcount — validated against MeetingRoom.capacity at booking time.
  attendeesCount Int?     @map("attendees_count")
  // Multi-day bookings get split into one row per day sharing this
  // UUID. Single-day reservations stay `null`. Used to bulk-cancel
  // and to render the "spans N days" hint on the detail dialog.
  seriesId       String?  @map("series_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  room     MeetingRoom @relation(fields: [roomId], references: [id])
  employee User        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([roomId, date])
  @@index([seriesId])
  @@map("room_bookings")
}

model Asset {
  id           String    @id @default(uuid()) @db.Uuid
  officeId     String    @map("office_id")
  name         String
  // Canonical category ("laptop" / "mobile" / "monitor" / "peripheral" /
  // "usb_accessory" / "software" / "furniture" / "other"). Kept on the
  // existing `type` column to avoid renaming — UI maps labels.
  type         String
  serialNo     String?   @map("serial_no")
  assignedTo   String?   @map("assigned_to") @db.Uuid
  purchaseDate DateTime? @map("purchase_date") @db.Date
  purchaseCost Decimal?  @map("purchase_cost") @db.Decimal(15, 2)
  status       String    @default("available")
  notes        String?

  // Hardware metadata accepted by the asset import format.
  manufacturer      String?
  model             String?
  colour            String?
  subType           String?   @map("sub_type")
  operatingSystem   String?   @map("operating_system")
  description       String?
  supportLink       String?   @map("support_link")
  activeServiceDate DateTime? @map("active_service_date") @db.Date
  department        String?
  // Sticker / QR code printed on the asset. Generated as
  // `<serialNo>-<YYYYMMDD>` when blank, but writeable so finance can
  // override with their own asset-register code.
  assetCode         String?   @map("asset_code")
  // Software-specific (folded into Asset for v1; carve out into a
  // SoftwareLicense model later if licensing/seat tracking lands).
  version           String?
  // Accounting / fixed-asset register fields.
  quantity          Int       @default(1)
  usefulLifeMonths  Int?      @map("useful_life_months")
  bookValue         Decimal?  @map("book_value") @db.Decimal(15, 2)
  disposalDate      DateTime? @map("disposal_date") @db.Date
  sellingPrice      Decimal?  @map("selling_price") @db.Decimal(15, 2)

  office   Office @relation(fields: [officeId], references: [id])
  assignee User?  @relation(fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([status])
  @@index([assetCode])
  @@map("assets")
}

// ── Voucher CRM ──────────────────────────────────────────
// Flat per-partner voucher ledger (Redeemed / Issued / Refund).
// Unlike the project-workspace CRMs this is a single table; the UI
// shows a grand-total row summing each numeric column server-side.
model VoucherEntry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partner   String   @db.VarChar(200)
  country   String?  @db.VarChar(120)
  redeemed  Int      @default(0)
  issued    Int      @default(0)
  refund    Int      @default(0)
  sortOrder Int      @default(0) @map("sort_order")
  addedBy   String?  @map("added_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator User? @relation("VoucherEntryCreator", fields: [addedBy], references: [id], onDelete: SetNull)

  @@index([partner])
  @@map("voucher_entries")
}
