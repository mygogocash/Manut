// ─── IT CRM workspace ───────────────────────────────────────
//
// Phase 1 of the IT CRM standalone workspace. Follows the per-team
// schema-isolation plan (Option A, 2026-05-26) — IT CRM is moving
// off the shared `projects` table (filtered by `team="it"`) into
// dedicated tables, same template as Partner phases 1-4. MVP shape
// matches Partner: project + member + column + task + comment +
// assignee. Milestones / dependencies / resources / activities /
// custom fields land in Phase 1b if IT users need them.
//
// Cascade rules mirror the Partner workspace: deleting an
// `ItProject` wipes its children; member / task / comment cascades
// follow the same precedent. No cross-module FK — IT CRM rows
// have no relation to Partner, Account, Project, or anything
// outside this graph.

model ItProject {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  description        String?
  status             String    @default("not_yet_started")
  ownerId            String    @map("owner_id") @db.Uuid
  startDate          DateTime? @map("start_date") @db.Date
  endDate            DateTime? @map("end_date") @db.Date
  productionLiveDate DateTime? @map("production_live_date") @db.Date
  goLiveDate         DateTime? @map("go_live_date") @db.Date
  revisedGoLiveDate  DateTime? @map("revised_go_live_date") @db.Date
  dependency         String?
  comment            String?
  sortOrder          Int       @default(0) @map("sort_order")
  department         String?
  // Intelligence fields (IT CRM dashboard redesign, 2026-05-30).
  // `statusChangedAt` is stamped whenever `status` changes so the
  // dashboard computes stage-aging / cycle-time directly instead of
  // inferring from `updatedAt` (which any edit bumps). `healthStatus`
  // is a manual RAG rating — "green" | "yellow" | "red" — driving the
  // portfolio heat-map exhibit; null = not yet rated. `effortPoints` is
  // relative sizing (story points / person-days) for velocity + load.
  statusChangedAt    DateTime? @map("status_changed_at")
  healthStatus       String?   @map("health_status")
  effortPoints       Int?      @map("effort_points")
  // Reversible archive (orthogonal to `status`): a set `archivedAt` hides the
  // project from the default IT CRM list (Active tab) while preserving its real
  // status. Null = active. Mirrors the SurveyForm archive convention; NOT the
  // hard-delete path. The dashboard analytics still count archived projects as
  // historical record. Archive state lives on this native row only — it does
  // not propagate to the shared `projects` board mirror.
  archivedAt         DateTime? @map("archived_at")
  // Auto-assign default for NEW tasks on this project (IT CRM only). `mode`
  // decides who a task's owner defaults to when the creator leaves it blank:
  //   none    – no default (current behaviour)
  //   creator – whoever creates the task
  //   owner   – the project owner
  //   user    – the specific `defaultAssigneeId` below
  // Resolved at task-create time in projects.service.addTask (the shared board
  // is the live writer). `defaultAssigneeId` is a plain user id with no FK —
  // matches the PartnerTaskResource.createdBy precedent — so it is validated
  // (must be an active user) before it is applied.
  defaultAssigneeMode String  @default("none") @map("default_assignee_mode")
  defaultAssigneeId   String? @map("default_assignee_id") @db.Uuid
  // Deadline-reminder debounce ladder. `remindersSent` holds the fired rung
  // markers (e.g. "golive-7", "golive-overdue") so the daily cron is
  // idempotent — re-running the same day is a no-op. Reset to [] in
  // ItCrmService.update() whenever a go-live date is edited, so a slipped
  // deadline re-arms its countdown. See it-crm.reminders.ts.
  remindersSent      Json      @default("[]") @map("reminders_sent")
  lastReminderSentAt DateTime? @map("last_reminder_sent_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  owner   User              @relation("ItProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members ItProjectMember[]
  columns ItProjectColumn[]
  tasks   ItProjectTask[]

  @@index([sortOrder])
  @@index([department])
  @@index([archivedAt])
  @@map("it_projects")
}

model ItProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id")
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")

  project ItProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User      @relation("ItProjectMembership", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("it_project_members")
}

model ItProjectColumn {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id")
  key       String
  label     String
  color     String @default("bg-zinc-500")
  sortOrder Int    @default(0) @map("sort_order")

  project ItProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@index([projectId])
  @@map("it_project_columns")
}

model ItProjectTask {
  id           String    @id @default(uuid()) @db.Uuid
  projectId    String    @map("project_id")
  parentTaskId String?   @map("parent_task_id") @db.Uuid
  title        String
  description  String?
  status       String    @default("todo")
  priority     String    @default("medium")
  ownerId      String?   @map("owner_id") @db.Uuid
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  sortOrder    Int       @default(0) @map("sort_order")
  // Flow metrics (IT CRM dashboard redesign, 2026-05-30).
  // `statusChangedAt` = last status transition; `completedAt` = when the
  // task entered the terminal `done` column (cleared if it moves back
  // out). Together they give precise cycle-time + throughput instead of
  // approximating from `updatedAt`. `effortPoints` = relative size for
  // velocity / burndown.
  statusChangedAt DateTime? @map("status_changed_at")
  completedAt     DateTime? @map("completed_at")
  effortPoints    Int?      @map("effort_points")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  project   ItProject               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner     User?                   @relation("ItProjectTaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  parent    ItProjectTask?          @relation("ItProjectTaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks  ItProjectTask[]         @relation("ItProjectTaskSubtasks")
  comments  ItProjectTaskComment[]
  assignees ItProjectTaskAssignee[]

  @@index([projectId])
  @@index([parentTaskId])
  @@map("it_project_tasks")
}

model ItProjectTaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task   ItProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User          @relation("ItProjectTaskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

