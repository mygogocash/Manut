model ItProjectTask {
  id              String    @id @default(uuid()) @db.Uuid
  projectId       String    @map("project_id")
  parentTaskId    String?   @map("parent_task_id") @db.Uuid
  title           String
  description     String?
  status          String    @default("todo")
  priority        String    @default("medium")
  ownerId         String?   @map("owner_id") @db.Uuid
  startDate       DateTime? @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  sortOrder       Int       @default(0) @map("sort_order")
  // Flow metrics for the IT CRM dashboard.
  // `statusChangedAt` = last status transition; `completedAt` = when the
  // task entered the terminal `done` column (cleared if it moves back
  // out). Together they give precise cycle-time + throughput instead of
  // approximating from `updatedAt`. `effortPoints` = relative size for
  // velocity / burndown.
  statusChangedAt DateTime? @map("status_changed_at")
  completedAt     DateTime? @map("completed_at")
  effortPoints    Int?      @map("effort_points")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  project   ItProject               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner     User?                   @relation("ItProjectTaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  parent    ItProjectTask?          @relation("ItProjectTaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks  ItProjectTask[]         @relation("ItProjectTaskSubtasks")
  comments  ItProjectTaskComment[]
  assignees ItProjectTaskAssignee[]

  @@index([projectId])
  @@index([parentTaskId])
  @@map("it_project_tasks")
}

