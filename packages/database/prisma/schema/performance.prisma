model AppraisalCycle {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime  @map("end_date") @db.Date
  status      String    @default("draft") // draft, active, closed
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  creator    User        @relation("AppraisalCycleCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  appraisals Appraisal[]

  @@map("appraisal_cycles")
}

model KRATemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  department  String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  appraisalKRAs AppraisalKRA[]

  @@map("kra_templates")
}

model Appraisal {
  id             String    @id @default(uuid()) @db.Uuid
  cycleId        String    @map("cycle_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  managerId      String?   @map("manager_id") @db.Uuid
  status         String    @default("pending") // pending, self_review, manager_review, completed
  selfRating     Int?      @map("self_rating")
  selfComment    String?   @map("self_comment")
  managerRating  Int?      @map("manager_rating")
  managerComment String?   @map("manager_comment")
  finalRating    Int?      @map("final_rating")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  cycle    AppraisalCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee User              @relation("AppraisalEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  manager  User?             @relation("AppraisalManager", fields: [managerId], references: [id], onDelete: SetNull)
  goals    Goal[]
  kras     AppraisalKRA[]
  comments AppraisalComment[]
  ratings  AppraisalRating[]

  @@unique([cycleId, employeeId])
  @@index([employeeId])
  @@index([managerId])
  @@map("appraisals")
}

model AppraisalKRA {
  id            String   @id @default(uuid()) @db.Uuid
  appraisalId   String   @map("appraisal_id") @db.Uuid
  kraTemplateId String?  @map("kra_template_id") @db.Uuid
  title         String
  description   String?
  weight        Int      @default(0)
  selfScore     Int?     @map("self_score")
  managerScore  Int?     @map("manager_score")
  createdAt     DateTime @default(now()) @map("created_at")

  appraisal   Appraisal    @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  kraTemplate KRATemplate? @relation(fields: [kraTemplateId], references: [id], onDelete: SetNull)

  @@index([appraisalId])
  @@map("appraisal_kras")
}

model AppraisalComment {
  id          String   @id @default(uuid()) @db.Uuid
  appraisalId String   @map("appraisal_id") @db.Uuid
  authorId    String   @map("author_id") @db.Uuid
  content     String
  createdAt   DateTime @default(now()) @map("created_at")

  appraisal Appraisal @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  author    User      @relation("AppraisalCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([appraisalId])
  @@map("appraisal_comments")
}

model AppraisalRating {
  id          String   @id @default(uuid()) @db.Uuid
  appraisalId String   @map("appraisal_id") @db.Uuid
  raterId     String   @map("rater_id") @db.Uuid
  category    String   @db.VarChar(50) // overall, leadership, technical, communication, etc.
  score       Int
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at")

  appraisal Appraisal @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  rater     User      @relation("AppraisalRatingRater", fields: [raterId], references: [id], onDelete: Cascade)

  @@unique([appraisalId, raterId, category])
  @@index([appraisalId])
  @@map("appraisal_ratings")
}

model Goal {
  id           String   @id @default(uuid()) @db.Uuid
  appraisalId  String   @map("appraisal_id") @db.Uuid
  title        String
  description  String?
  weight       Int      @default(0)
  selfScore    Int?     @map("self_score")
  managerScore Int?     @map("manager_score")
  status       String   @default("not_started") // not_started, in_progress, completed
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  appraisal Appraisal @relation(fields: [appraisalId], references: [id], onDelete: Cascade)

  @@index([appraisalId])
  @@map("goals")
}
