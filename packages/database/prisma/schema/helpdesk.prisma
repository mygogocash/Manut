/// IT Helpdesk ticket. Employees create tickets ("reset email password",
/// "Slack seat", "VPN broken"); the IT team works them through a Kanban
/// board grouped by status.
///
/// `ticketNumber` is a friendly serial (IT-123) used in the UI and any
/// future email / Slack threads. `id` stays a UUID so the URL doesn't
/// reveal ordering, and so we can hand out the id without leaking the
/// total ticket count.
model HelpdeskTicket {
  id             String    @id @default(uuid()) @db.Uuid
  ticketNumber   Int       @unique @default(autoincrement()) @map("ticket_number")
  title          String    @db.VarChar(200)
  description    String
  /// 'account-access' | 'software-access' | 'hardware' | 'network'
  /// | 'file-drive' | 'security' | 'procurement' | 'other'
  category       String    @default("other")
  /// 'low' | 'medium' | 'high' | 'urgent'
  priority       String    @default("medium")
  /// 'open' | 'in-progress' | 'review' | 'resolved' | 'closed'
  /// `review` = work done by IT, awaiting requester confirmation before
  /// the ticket flips to `resolved` / `closed`.
  status         String    @default("open")
  createdById    String    @map("created_by") @db.Uuid
  assigneeId     String?   @map("assignee_id") @db.Uuid
  resolutionNote String?   @map("resolution_note")
  resolvedAt     DateTime? @map("resolved_at")
  closedAt       DateTime? @map("closed_at")
  /// SLA + quality signals (IT CRM dashboard redesign, 2026-05-30).
  /// `firstResponseAt` is stamped the first time IT engages — the status
  /// leaves `open` or an assignee is set — and drives response-SLA
  /// attainment. `reopenedCount` increments whenever the ticket bounces
  /// from a resolved/closed state back to an active one, feeding the
  /// first-fix-rate / quality exhibit.
  firstResponseAt DateTime? @map("first_response_at")
  reopenedCount   Int       @default(0) @map("reopened_count")
  /// Array of `{ name, url, mimeType, size }` for attachments uploaded via
  /// the shared `uploads` Supabase bucket. Kept as JSON because v1 doesn't
  /// need separate join-table queries.
  attachments    Json?
  /// Optional cross-system link to a GitHub issue (Sid + BD feedback,
  /// 2026-05-24). Populated by the outbound sync worker when GitHub
  /// integration is enabled; nullable for tickets created before the
  /// feature shipped or while the integration is off.
  githubIssueNumber Int?    @unique @map("github_issue_number")
  githubIssueUrl    String? @map("github_issue_url")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  createdBy User  @relation("HelpdeskTicketCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignee  User? @relation("HelpdeskTicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments  HelpdeskComment[]

  @@index([status])
  @@index([createdById])
  @@index([assigneeId])
  @@index([category])
  @@map("helpdesk_tickets")
}

/// IT-managed validator monitor alert rules. Each rule watches one
/// metric on a specific validator node (or any node) and fires an email
/// to `email` when the condition is true on a freshly-fetched report.
///
/// `nodeId` null means "match any node in the report" — the operator
/// applies to each row independently. A rule with `nodeId` set only
/// evaluates that row.
///
/// `lastTriggeredAt` + `cooldownMinutes` debounce repeat fires. The
/// service evaluates on every cache-miss fetch (≤ 5 min), so without
/// cooldown a single low-balance node would email on every refresh.
/// Default cooldown is 1 day (1440 min) matching upstream's daily email
/// cadence.
model ValidatorNodeAlert {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(120)
  /// Null = match every row in the report.
  nodeId          String?   @map("node_id")
  /// 'balance' | 'burn' | 'runway'
  field           String
  /// 'lt' | 'lte' | 'gt' | 'gte' | 'eq'
  operator        String
  threshold       Decimal   @db.Decimal(28, 8)
  email           String    @db.VarChar(255)
  enabled         Boolean   @default(true)
  cooldownMinutes Int       @default(1440) @map("cooldown_minutes")
  lastTriggeredAt DateTime? @map("last_triggered_at")
  createdById     String    @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  createdBy User @relation("ValidatorNodeAlertCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([enabled])
  @@index([nodeId])
  @@map("validator_node_alerts")
}

/// Notification configuration for the IT helpdesk. Singleton row
/// (enforced by the unique `singleton` column = always `true`) holding
/// the recipient list emailed when a new ticket is created. Creator
/// + status-change emails to the requester are unconditional — only
/// the IT-team fan-out is operator-controlled, since that's the
/// noisiest channel.
model HelpdeskSettings {
  id                       String   @id @default(uuid()) @db.Uuid
  /// Always `true`; the unique constraint enforces a single row.
  singleton                Boolean  @unique @default(true)
  /// Email addresses fanned out on every new ticket creation.
  notifyEmails             String[] @default([]) @map("notify_emails")
  /// Master toggles: operator can suppress either fan-out without
  /// emptying the recipient list.
  notifyOnCreate           Boolean  @default(true) @map("notify_on_create")
  notifyCreatorOnCreate    Boolean  @default(true) @map("notify_creator_on_create")
  notifyCreatorOnStatus    Boolean  @default(true) @map("notify_creator_on_status")
  /// GitHub workflow integration (Sid + BD feedback, 2026-05-24). When
  /// `githubEnabled` is true, ticket creation pushes an issue to the
  /// configured repo and an inbound webhook mirrors issue / PR state
  /// changes back onto ticket.status:
  ///   issue labeled `githubLabelInProgress` → status = "in-progress"
  ///   PR merged that closes the issue        → status = "review"
  ///   issue closed                           → status = "resolved"
  /// Token is AES-GCM encrypted at rest (same envelope as Google).
  /// Webhook secret is plaintext (treated as HMAC seed, not a credential).
  githubEnabled            Boolean @default(false) @map("github_enabled")
  githubRepoOwner          String? @map("github_repo_owner")
  githubRepoName           String? @map("github_repo_name")
  githubTokenEncrypted     String? @map("github_token_encrypted")
  githubWebhookSecret      String? @map("github_webhook_secret")
  githubLabelInProgress    String  @default("in progress") @map("github_label_in_progress")
  githubLabelReview        String  @default("review") @map("github_label_review")
  updatedById              String?  @map("updated_by") @db.Uuid
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("HelpdeskSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("helpdesk_settings")
}

/// Plain-text discussion thread on a helpdesk ticket. Lets the requester
/// and the IT assignee go back and forth without forcing a status change
/// or rewriting the original description. v1 keeps it append-only — edit
/// / delete affordances can land later once we know HR / IT actually
/// want them.
model HelpdeskComment {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ticket HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User           @relation("HelpdeskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("helpdesk_comments")
}
