# Copy to .env for local development. Every value below is a placeholder.
# Never reuse credentials from the imported source repository or another company.

# Postgres (Prisma / Hyperdrive authoritative — not Supabase DB)
DATABASE_URL=postgresql://postgres.project:password@pooler.example:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.project:password@pooler.example:5432/postgres

# Local application URLs
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Must include /api — app-core paths are relative beneath this base (/auth/login).
# Hosted web may use same-origin /api; native needs an HTTPS Worker origin + /api.
EXPO_PUBLIC_API_URL=http://localhost:3001/api
WEB_BASE_URL=http://localhost:3000
PORTAL_URL=http://localhost:3000

# Server-only application secrets
CRON_SECRET=replace-with-at-least-32-random-characters
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-value
INTEGRATIONS_TOKEN_KEY=

# Cloudflare bindings and local gateway configuration
# Live Worker service name: manut
# Production: https://manu.xyz (+ https://manut.bettergogocash.workers.dev)
# Preview: https://preview.manu.xyz (+ *.manut.bettergogocash.workers.dev)
API_ORIGIN=http://localhost:3001
# Express→edge Durable Object messageBus fan-out (optional until Worker is live).
# EDGE_REALTIME_BRIDGE_SECRET must match the Worker's EDGE_SIGNING_KEY (≥32 chars).
EDGE_REALTIME_ORIGIN=
EDGE_REALTIME_BRIDGE_SECRET=
# Worker Hyperdrive boundary (apps/edge wrangler vars + binding). Keep false
# until a Manut-owned Hyperdrive config id is bound as HYPERDRIVE_DATABASE.
ENABLE_HYPERDRIVE_BOUNDARY=false
# Worker JWT verification (Cloudflare Access application — names only).
# AUTH_JWKS_URL=https://<team>.cloudflareaccess.com/cdn-cgi/access/certs
# AUTH_ISSUER=https://<team>.cloudflareaccess.com
# AUTH_AUDIENCE=<access-application-aud>
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
# Worker-only: comma-separated HTTPS origins for FileUpload receipt provenance
# on Hyperdrive (R2 custom hosts). Empty = proxy managed receipts to Express.
TRUSTED_STORAGE_ORIGINS=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=manut-intranet-uploads

# Express parity bridge — temporary identity/storage until Access + R2 own the path.
# Prefer Worker AUTH_JWKS_* + R2 UPLOADS. These names remain for Express-only code.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional email provider
EMAIL_SERVICE_API_KEY=
EMAIL_SERVICE_URL=
EMAIL_FROM=

# Optional Google Workspace integration
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/integrations/google/oauth-callback
GOOGLE_SHEETS_SA_KEY=

# Optional telemetry. Disabled unless explicitly set to 1.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_API_KEY=
POSTHOG_HOST=
NEXT_PUBLIC_TELEMETRY_ENABLED=0
TELEMETRY_ENABLED=0

# Optional module configuration
LEAVE_NOTIFICATION_EXCLUDE=
TRAVEL_APPROVED_CC=
VISA_REMINDER_CC=
VISA_90DAY_REMINDER_CC=
MAGIC_LINK_ALLOWED_ROLES=
