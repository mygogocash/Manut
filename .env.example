# Copy to .env for local development. Every value below is a placeholder.
# Never reuse credentials from the imported source repository or another company.

# Supabase / Postgres
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
DATABASE_URL=postgresql://postgres.project:password@pooler.example:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.project:password@pooler.example:5432/postgres

# Local application URLs
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
NEXT_PUBLIC_APP_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000
PORTAL_URL=http://localhost:3000

# Server-only application secrets
CRON_SECRET=replace-with-at-least-32-random-characters
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-value
INTEGRATIONS_TOKEN_KEY=

# Cloudflare bindings and local gateway configuration
API_ORIGIN=http://localhost:3001
# Express→edge Durable Object messageBus fan-out (optional until Worker is live).
# EDGE_REALTIME_BRIDGE_SECRET must match the Worker's EDGE_SIGNING_KEY (≥32 chars).
EDGE_REALTIME_ORIGIN=
EDGE_REALTIME_BRIDGE_SECRET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=manut-intranet-uploads

# Optional email provider
EMAIL_SERVICE_API_KEY=
EMAIL_SERVICE_URL=
EMAIL_FROM=

# Optional Google Workspace integration
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/integrations/google/oauth-callback
GOOGLE_SHEETS_SA_KEY=

# Optional telemetry. Disabled unless explicitly set to 1.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_API_KEY=
POSTHOG_HOST=
NEXT_PUBLIC_TELEMETRY_ENABLED=0
TELEMETRY_ENABLED=0

# Optional module configuration
LEAVE_NOTIFICATION_EXCLUDE=
TRAVEL_APPROVED_CC=
VISA_REMINDER_CC=
VISA_90DAY_REMINDER_CC=
MAGIC_LINK_ALLOWED_ROLES=
